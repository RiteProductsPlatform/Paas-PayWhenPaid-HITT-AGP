{
    "description": "",
    "routerFlow": "main",
    "variables": {
    "currentFlow": {
      "type": "string"
    },
    "messagesADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "itemType": "messageType",
        "keyAttributes": "id"
      }
    },
    "messageToast": {
        "type": "string"
      },
      "messagesBannerADP": {
        "type": "vb/ArrayDataProvider2",
        "defaultValue": {
          "itemType": "MessagesBannerType",
          "keyAttributes": "id"
        }
      },
      "messageId": {
        "type": "number",
        "defaultValue": 1
      }

    },
    "metadata": {},
    "types": {
      "MessagesBannerType": {
        "id": "number",
        "messageType": "string",
        "primaryText": "string",
        "primaryActionLabel": "string",
        "secondaryText": "any",
        "secondaryActionLabel": "string"
      },
    "messageType": {
      "autoTimeout": "number",
      "category": "string",
      "detail": "string",
      "id": "string",
      "severity": "string",
      "summary": "string",
      "timestamp": "string"
    }
    },
    "eventListeners": {
    "application:spShowToast": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "showMessageToast"
        }
      ]
    },
    "buttonAction": {
      "chains": [
        {
          "chain": "application:toggleDrawerListener"
        }
      ]
    },
    "messagesBannerSpClose": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "closeMessageBanner"
        }
      ]
    },
    "navigationListSelection": {
      "chains": [
        {
          "chain": "navigationHandler",
          "parameters": {
            "selection": "{{ $event.detail.value }}",
            "currentFlow": "[[ $event.detail ]]"
          }
        }
      ]
    },
    "vbNotification": {
      "chains": [
        {
          "parameters": {
            "event": "{{ { id: $event.key, summary: $event.summary, detail: $event.message, severity: $event.type, autoTimeout: $event.displayMode === 'transient' ? 0 : -1 } }}"
          },
          "chain": "showNotificationMessage"
        }
      ]
    }

    },
    "imports": {
    "components": {
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-conveyor-belt": {
        "path": "ojs/ojconveyorbelt"
      },
      "oj-drawer-layout": {
        "path": "ojs/ojdrawerlayout"
      },
      "oj-drawer-popup": {
        "path": "ojs/ojdrawerpopup"
      },
      "oj-messages": {
        "path": "ojs/ojmessages"
      },
      "oj-navigation-list": {
        "path": "ojs/ojnavigationlist"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      },
      "oj-sp-messages-banner": {
        "path": "oj-sp/messages-banner/loader"
      },
      "oj-sp-messages-toast": {
        "path": "oj-sp/messages-toast/loader"
      }

    }
    },
    "translations": {}
  }