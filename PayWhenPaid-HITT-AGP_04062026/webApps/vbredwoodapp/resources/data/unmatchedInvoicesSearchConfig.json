{
  "description": "PWP Unmatched Invoices smart search configuration",
  "filters": {
    "Project": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Project Number",
      "options": {
        "field": "project_number",
        "optionsData": "[[ $search.filters.Project.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.Project.options.optionsKeys ]]"
      },
      "data": {}
    },
    "Supplier": {
      "type": "oj-sp/smart-search/default-filters/SelectSingleFilter",
      "label": "Supplier Name",
      "options": {
        "field": "supplier_name",
        "optionsData": "[[ $search.filters.Supplier.options.optionsData ]]",
        "optionsKeys": "[[ $search.filters.Supplier.options.optionsKeys ]]"
      },
      "data": {}
    }
  }
}
